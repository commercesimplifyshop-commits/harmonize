# Copy to .env for local development. On Vercel/HostGator set the same keys as environment variables.
PORT=3001
NODE_ENV=development
# Extra origins allowed to call the api directly (comma-separated). The site normally calls it
# on the same domain through a rewrite, so this stays empty in production.
ALLOWED_ORIGINS=

# MySQL. Add DATABASE_SSL=true for cloud providers that require TLS, and DATABASE_SSL_CA with the
# provider's CA certificate (PEM, \n-escaped) when it is not signed by a public authority.
DATABASE_URL=mysql://usuario:senha@localhost:3306/harmonize
DATABASE_SSL=false
DATABASE_SSL_CA=

# Signs the 15-minute access tokens. Long random string, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# reCAPTCHA v3 (login and contact form). Empty = not checked.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Contact form e-mail via Resend (https://resend.com). Empty key = messages are only stored in
# the panel. Without a verified domain Resend only delivers to the account owner's address.
RESEND_API_KEY=
CONTACT_TO=annecryst@hotmail.com
CONTACT_FROM=Site Harmonize <onboarding@resend.dev>

# Where uploaded photos go: "local" (UPLOAD_DIR, served at /uploads; HostGator) or "blob"
# (Vercel Blob, needs BLOB_READ_WRITE_TOKEN).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
BLOB_READ_WRITE_TOKEN=

# Admin accounts created by `npm run db:seed` when they don't exist yet ("Name|email", comma-separated).
# Each new account gets a random password printed once in the terminal.
ADMIN_USERS=Cris Rebouças|annecryst@hotmail.com
