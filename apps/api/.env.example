# Copy to .env. Only PORT is used today; the rest is what v2 will read.
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=

# v2: MySQL database created in cPanel (HostGator)
DATABASE_URL=mysql://usuario:senha@localhost:3306/harmonize

# v2: auth. Long random strings (e.g. `openssl rand -base64 48`), different per environment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# v2: reCAPTCHA (login and contact form)
RECAPTCHA_SECRET=

# v2: contact form e-mail (HostGator mailbox)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# v2: where uploaded photos are stored (outside the web build folder)
UPLOAD_DIR=./uploads
